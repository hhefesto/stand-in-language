#!/usr/bin/env bash
set -euo pipefail

# Check every Bend module before it is committed: types, termination and
# laws, the same check `nix flake check` runs. Bend has no formatter yet.
echo "Checking the Bend modules (bend bend/Everything.bend --check-only):"
BEND_NO_TELEMETRY=1 nix run .#bend -- bend/Everything.bend --check-only
