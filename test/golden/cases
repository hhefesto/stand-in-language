# The golden cases, read by run.sh (a bash file, sourced).
#
#   case_ NAME PROGRAM STDIN [ARGS...]   telomare ARGS on PROGRAM, fed STDIN
#   repl_ NAME EXPR                      telomare-repl --expr EXPR
#
# STDIN takes printf %b escapes, one line per input the program asks for. The
# port keeps the IC runtime only, so the cases are the interaction-net ones
# plus the plain sized run, whose output is the semantics IC must reproduce,
# and the static report. A program's cases share one directory, in order: its
# `--compile` (haskell-final's `--ic --compile` too) writes the .telc the
# `telc` cases then run.

# The smallest recursion: no input, one answer.
case_ tc_ultra_minimal.run tc_ultra_minimal.tel ''
case_ tc_ultra_minimal.certificate tc_ultra_minimal.tel '' --certificate
case_ tc_ultra_minimal.ic tc_ultra_minimal.tel '' --ic
case_ tc_ultra_minimal.ic-meter tc_ultra_minimal.tel '' --ic --meter
case_ tc_ultra_minimal.ic-certificate tc_ultra_minimal.tel '' --ic --certificate
case_ tc_ultra_minimal.ic-draw-net tc_ultra_minimal.tel '' --ic --draw-net
case_ tc_ultra_minimal.ic-compile tc_ultra_minimal.tel '' --ic --compile
case_ tc_ultra_minimal.telc-ic tc_ultra_minimal.telc '' --ic
case_ tc_ultra_minimal.telc-ic-certificate tc_ultra_minimal.telc '' --ic --certificate
case_ tc_ultra_minimal.compile tc_ultra_minimal.tel '' --compile
case_ tc_ultra_minimal.telc-run tc_ultra_minimal.telc ''
case_ tc_ultra_minimal.telc-certificate tc_ultra_minimal.telc '' --certificate

# testchar.tel uses `not` without importing the Prelude, so the command line
# rejects it; the test suite prepended the Prelude to reach its parity cases
# ('A' odd, 'B' even: haskell-final's test/Spec.hs). One case keeps the error.
case_ testchar.run test/programs/testchar.tel 'A\n'

# Two digits in, their sum out, over the Prelude; bad input aborts.
case_ simpleplus.run test/programs/simpleplus.tel '3 4\n'
case_ simpleplus.run-carry test/programs/simpleplus.tel '9 9\n'
case_ simpleplus.run-abort test/programs/simpleplus.tel '9 a\n'
case_ simpleplus.certificate test/programs/simpleplus.tel '' --certificate
case_ simpleplus.ic test/programs/simpleplus.tel '3 4\n' --ic
case_ simpleplus.ic-carry test/programs/simpleplus.tel '9 9\n' --ic
case_ simpleplus.ic-abort test/programs/simpleplus.tel '9 a\n' --ic
case_ simpleplus.ic-meter test/programs/simpleplus.tel '3 4\n' --ic --meter
case_ simpleplus.ic-certificate test/programs/simpleplus.tel '' --ic --certificate
case_ simpleplus.ic-draw-net test/programs/simpleplus.tel '' --ic --draw-net
case_ simpleplus.ic-compile test/programs/simpleplus.tel '' --ic --compile
case_ simpleplus.telc-ic test/programs/simpleplus.telc '3 4\n' --ic
case_ simpleplus.telc-ic-certificate test/programs/simpleplus.telc '' --ic --certificate
case_ simpleplus.compile test/programs/simpleplus.tel '' --compile
case_ simpleplus.telc-run test/programs/simpleplus.telc '3 4\n'
case_ simpleplus.telc-certificate test/programs/simpleplus.telc '' --certificate

# A whole game, player 1 taking the top row.
case_ tictactoe.run tictactoe.tel '1\n4\n2\n5\n3\n'
case_ tictactoe.certificate tictactoe.tel '' --certificate
case_ tictactoe.ic tictactoe.tel '1\n4\n2\n5\n3\n' --ic
# The game haskell-final's test suite played (test/ResolverTests.hs, "test
# tictactoe.tel": fullRunTicTacToeString is this transcript plus the test
# harness's closing "done"), sized and on the net.
case_ tictactoe.test-game tictactoe.tel '1\n9\n2\n8\n3\n'
case_ tictactoe.test-game-ic tictactoe.tel '1\n9\n2\n8\n3\n' --ic
case_ tictactoe.ic-meter tictactoe.tel '1\n4\n2\n5\n3\n' --ic --meter
case_ tictactoe.ic-certificate tictactoe.tel '' --ic --certificate
case_ tictactoe.ic-draw-net tictactoe.tel '' --ic --draw-net
case_ tictactoe.ic-compile tictactoe.tel '' --ic --compile
case_ tictactoe.telc-ic tictactoe.telc '1\n4\n2\n5\n3\n' --ic
case_ tictactoe.telc-ic-certificate tictactoe.telc '' --ic --certificate
case_ tictactoe.compile tictactoe.tel '' --compile
case_ tictactoe.telc-run tictactoe.telc '1\n4\n2\n5\n3\n'
case_ tictactoe.telc-certificate tictactoe.telc '' --certificate

# Unsized (--fast): the same displays with every recursion unbounded, the
# unrolls each site made, the static report without counts, and the fuel
# cap. The port's meter counts interactions and each unroll once, and its
# fuel is interactions (test/golden/port).
case_ simpleplus.fast test/programs/simpleplus.tel '3 4\n' --fast
case_ simpleplus.fast-meter test/programs/simpleplus.tel '3 4\n' --fast --meter
case_ simpleplus.fast-certificate test/programs/simpleplus.tel '' --fast --certificate
case_ simpleplus.fast-fuel test/programs/simpleplus.tel '3 4\n' --fast --fuel 20
case_ tc_ultra_minimal.fast-meter tc_ultra_minimal.tel '' --fast --meter
case_ tictactoe.fast tictactoe.tel '1\n9\n2\n8\n3\n' --fast

# Where sizing stops (test/programs/limits/README.md).
case_ unbounded-input-recursion.certificate test/programs/limits/unbounded-input-recursion.tel '' --certificate
case_ unbounded-input-recursion.ic test/programs/limits/unbounded-input-recursion.tel '' --ic
case_ over-budget-recursion.certificate test/programs/limits/over-budget-recursion.tel '' --certificate
case_ over-budget-recursion.ic-certificate test/programs/limits/over-budget-recursion.tel '' --ic --certificate
# Unsized, the program sizing rejects runs.
case_ unbounded-input-recursion.fast test/programs/limits/unbounded-input-recursion.tel 'a\n' --fast

# The REPL over the Prelude (CI's smoke test is the first).
repl_ repl.succ 'succ 7'
repl_ repl.factorial 'c2d (factorial 4)'
repl_ repl.pair '(4, 5)'
