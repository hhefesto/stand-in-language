module noGeneralRecursion

-- LIMIT: tel2 is total. There is no `fix` and no general recursion; a
--   definition may not refer to itself (dependency cycles are rejected).
--   `countdown` below is exactly the recursion you would write in Haskell,
--   and that is precisely what tel2 refuses.
-- EXPECTED: compile error.
-- OBSERVED: cyclic definitions: countdown, init, main, step
--   (main/init/step are the synthesized machine entries; `countdown` calling
--    itself closes the cycle the compiler refuses.)
-- FIX: see the commented workaround below the faulty code.
type State = Nat

countdown : Nat -o Nat = \n ->
  case n of
    0 -> 0
    succ k -> countdown k

-- WORKAROUND (compiles): bounded recursion. Over a Nat the fuel is the nat's
-- own value, so use iterate (below), or the { test, rec, last } triple for the
-- general shape (see recursion-triple-unbounded.tel2):
-- increment : Nat -o Nat = \n -> succ n
-- countUp : Nat -o Nat = \n -> iterate n from 0 with increment

main : Text * State -o Reply State = \io ->
  let (input, s) = io
      _ = input
   in case s of
        0 -> let r = countdown 5 in let _ = r in ("done\n", left ())
        n -> let _ = n in ("", left ())
