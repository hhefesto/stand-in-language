module noDerelictionWall

-- LIMIT: the EAL exponential has no dereliction (`!a -> a`). Every loop result
--   is boxed one level deeper and can never be unboxed, so an unboxed value
--   cannot stay live ACROSS a loop. Here `extra` is produced before the
--   `iterate` and consumed after it (`add (result, extra)`), which tel2
--   rejects: the pre-loop context must be gone by the time the loop runs.
-- EXPECTED: compile error about live context after recursion.
-- OBSERVED: unboxed context cannot remain live after recursion
-- FIX: see the commented workaround below the faulty code.
type State = Nat

increment : Nat -o Nat = \n -> succ n

main : Text * State -o Reply State = \request ->
  let (input, s) = request
      _ = input
   in case s of
        0 -> ("", right 3)
        n -> let (fuel, extra) = copy n
              in let result : Nat = iterate fuel from 0 with increment
                  in ("", right add (result, extra))

-- WORKAROUND (compiles): consume `n` once as the fuel and let the continuation
-- use only the loop's result, so nothing unboxed survives the loop:
--         n -> let result : Nat = iterate n from 0 with increment
--               in ("", right result)
