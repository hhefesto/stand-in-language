module impoverishedPrimitives

-- LIMIT: the primitive vocabulary is deliberately tiny.
--   * Nat has only `succ` and `add`. There is no `*`, `-`, `/`, `<`, or `==`.
--     Predecessor exists only structurally (`case n of { 0 -> ..; succ k -> ..}`),
--     and the only test is zero-vs-nonzero (`if n`).
--   * Text (= List Nat of code points) can only be extended by a LITERAL prefix
--     via `prepend "lit" rest`; there is no runtime append of two Text values,
--     no comparison beyond whole-literal `case`, and no length/substring.
--   The two definitions below each hit one wall.
-- EXPECTED (product):  compile error — `mul` is not a primitive (nothing binds it).
-- OBSERVED (product):  unknown variable mul          (product alone)
-- EXPECTED (joinText): compile error — `prepend`'s prefix must be a literal.
-- OBSERVED (joinText): unknown variable prepend       (joinText alone)
-- NOTE: as shipped, both defs fail; the compiler reports the first wall it
--   reaches, which happens to be `unknown variable prepend`. Comment out
--   `joinText` to see `unknown variable mul`.
-- FIX: see the commented workarounds beside each faulty def below.
type State = Nat

product : Nat * Nat -o Nat = \(a, b) -> mul (a, b)

-- WORKAROUND (compiles): multiply by a CONSTANT with a bounded loop (the step
-- adds the constant). Two RUNTIME nats can't be hand-rolled: a closed loop step
-- can't capture the other factor.
-- addThree : Nat -o Nat = \acc -> add (acc, 3)
-- triple   : Nat -o Nat = \n   -> iterate n from 0 with addThree   -- n * 3

joinText : Text * Text -o Text = \(a, b) -> prepend a b

-- WORKAROUND (compiles): extend Text with a LITERAL prefix (there is no runtime
-- append of two Text values; build longer text with prepend / cons chains):
-- greet : Text -o Text = \name -> prepend "Hello, " name

main : Text * State -o Reply State = \io ->
  let (input, s) = io
      _ = input
   in case s of
        0 -> let r = product (3, 4) in let _ = r in ("done\n", left ())
        n -> let _ = n in ("", left ())
