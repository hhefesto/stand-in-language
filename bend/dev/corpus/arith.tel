import Prelude
b = \x -> if x then "1" else "0"
rEq = \r n d -> and (dEqual (left (right r)) n) (dEqual (right (right r)) d)
main = \input ->
  ( concat [ b (dEqual (dPlus 1 2) 3), b (dEqual (dMinus 5 3) 2), b (dEqual (dMinus 0 1) 0)
           , b (dEqual (dTimes 3 4) 12), b (dEqual (dDiv 8 2) 4), b (dEqual (dEqual 3 3) 1)
           , b (dEqual (dEqual 3 4) 0), b (dEqual (dMod 10 3) 1), b (dEqual (gcd 48 18) 6)
           , b (dEqual (lcm 12 15) 60), b (dEqual (dPow 2 3) 8), b (dEqual (dPow 5 0) 1)
           , b (dEqual (dPow 0 0) 1), b (dEqual (dFactorial 5) 120)
           , b (rEq (rPlus (fromRational 1 2) (fromRational 1 2)) 1 1)
           , b (rEq (rMinus (fromRational 1 2) (fromRational 1 2)) 0 1)
           , b (rEq (rTimes (fromRational 1 2) (fromRational 1 2)) 1 4)
           , b (rEq (rDiv (fromRational 1 2) (fromRational 1 2)) 1 1)
           ]
  , 0)
