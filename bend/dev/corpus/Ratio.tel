import Prelude
rNum = \x -> left x
rDen = \x -> right x
fromRational = \n d -> if dEqual d 0
                       then abort "Denominator cannot be zero"
                       else let g = gcd n d
                            in (dDiv n g, dDiv d g)
rPlus = \a b -> fromRational (plusByte (timesByte (rNum a) (rDen b)) (timesByte (rNum b) (rDen a)))
                             (timesByte (rDen a) (rDen b))
rTimes = \a b -> fromRational (timesByte (rNum a) (rNum b))
                              (timesByte (rDen a) (rDen b))
rMinus = \a b -> fromRational (minusByte (timesByte (rNum a) (rDen b)) (timesByte (rNum b) (rDen a)))
                              (timesByte (rDen a) (rDen b))
rDiv = \a b -> fromRational (timesByte (rNum a) (rDen b))
                            (timesByte (rDen a) (rNum b))
