import Prelude
b = \x -> if x then "1" else "0"
main = \input ->
  ( concat [ b (dEqual (plusByte 1 2) 3), b (dEqual (minusByte 5 3) 2)
           , b (dEqual (timesByte 3 4) 12), b (dEqual (dDiv 8 2) 4), b (dEqual (dEqual 3 3) 1)
           , b (dEqual (dEqual 3 4) 0), b (dEqual (modByte 10 3) 1)
           ]
  , 0)
