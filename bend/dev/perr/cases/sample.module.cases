-- Ultra ultra minimal recursive test case
main = \input -> let result = { \i -> 0                -- Base case (never used)
                              , \recur i -> recur i     -- Recursoin (infinite loop)
                              , \i -> i                 -- Default: returns input
                              } (left (left input))  
                 in (if result then "EV" else "O", 0)-- hi
