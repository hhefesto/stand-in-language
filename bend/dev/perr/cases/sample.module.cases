id = \x -> x

userAbort = \x -> (1,x)

Bool = \vv -> if vv
              then if (left vv)
                   then userAbort "Bool cannot have non-zero val in left of pair"
                   else if (right vv)
                        then userAbort "Bool cannot have non-zero val in right of pair"
                        else 0
              else 0

toBool = \b -> if b then 1 else 0

ite = \(i : Bool) t e -> if i then t else e

and = \(a : Bool) (b : Bool) -> if a then b else 0

or = \(a : Bool) (b : Bool) -> if a then 1 else b

not = \(x : Bool) -> if x then 0 else 1

succ = \x -> (x,0)

d2c = \n f b -> { id
                , \recur i  -> f (recur (left i))
                , \i -> b
                } n

c2d = \c -> c succ 0

dPlus = \a b -> d2c b succ a

plus = \m n f x -> m f (n f x)

dTimes = \a b -> d2c b (\x -> dPlus a x) 0

times = \m n f -> m (n f)

dPow = \a b -> d2c b (dTimes a) (succ 0)

pow = \m n -> n m

dMinus = \a b -> d2c b (\x -> left x) a

minus = \a b -> d2c (b (\x -> left x) (c2d a))

range = \a b -> { \i -> dMinus b i
                , \recur i -> (i, recur (i,0))
                , \i -> 0
        '       } a

map = \f -> { id
            , \recur l -> (f (left l), recur (right l))
            , \l -> 0
            }

foldr = \f b ta -> let fixed = { id
                               , \recur l accum -> f (left l) (recur (right l) accum)
                               , \l accum -> accum
                               }
                   in fixed ta b

foldl = \f b ta -> let fixed = { id
                               , \recur l accum -> recur (right l) (f accum (left l))
                               , \l accum -> accum
                               }
                   in fixed ta b

zipWith = \f a b -> let fixed = { \ab -> and (toBool (left ab)) (toBool (right ab))
                                , \recur ab -> (f (left (left ab)) (left (right ab))
                                               , recur (right (left ab), right (right ab))
                                               )
                                , \ab -> 0
                                }
                    in fixed (a,b)

filter = \f -> foldr (\a b -> if f a then (a, b) else b) 0

dEqual = \a b -> let equalsOne = \x -> if x then (not (toBool (left x))) else 0
                 in if a then equalsOne (d2c (left a) (\x -> left x) b)
                         else not (toBool b)

dDiv = \a b -> if (dEqual b 0)
               then abort "Undefined"
               else
                 { \p       -> dMinus (left p) (right p)
                 , \recur p -> succ (recur (dMinus (left p) (right p), right p))
                 , \p       -> if (dEqual (left p) (right p)) then succ 0 else 0
                 } (a, b)

listLength = foldr (\a b -> succ b) 0

listEqual = \a b -> let pairsEqual = zipWith dEqual a b
                        lengthEqual = dEqual (listLength a) (listLength b)
                    in foldr and 1 (lengthEqual,pairsEqual)

listPlus = \a b -> foldr (\x l -> (x,l)) b a

flip = \f a b -> f b a

-- functional concatenation
con  = \f g x -> g (f x)

concat = foldr listPlus 0

drop = \n l -> n (\x -> right x) l

take = \n l -> let lengthed = n (\x -> (0,x)) 0
               in zipWith (\a b -> a) l lengthed

factorial = \n -> foldr (\a b -> times (d2c a) b) $1 (range 1 (n,0))

dFactorial = \n -> factorial n succ 0

quicksort = { \l -> right l
            , \recur l -> let t = left l
                              test = \x -> toBool (dMinus x t)
                              p1 = filter test (right l)
                              p2 = filter (<x -> not (test x)) (right l)
                          in listPlus (recur p2) (t,(recur p1))
            , id
            }

-- abort is a builtin, so each call can report where it was made

assert = \t s -> if not t then (1, s) else 0

-- useful for making sure main input isn't unbounded
truncate = \n ->
  let layer = \recur current -> if current
                                then (recur (left current), recur (right current))
                                else 0
  in n layer (\x -> 0)

min = \a b -> { \p -> and (toBool (left p)) (toBool (right p))
              , \recur p -> recur (left (left p), left (right p))
              , \p -> if (left p) then b else a
              } (a,b)

max = \a b -> { \p -> and (toBool (left p)) (toBool (right p))
              , \recur p -> recur (left (left p), left (right p))
              , \p -> if (left p) then a else b
              } (a,b)

fakeRecur = \n t r b -> n (\rec i -> if t i then r rec i else b i) b

dMod = \a b -> dMinus a (dTimes b (dDiv a b))

gcd = \a b ->
  { \p -> not (dEqual (right p) 0)
  , \recur p -> recur (right p, dMod (left p) (right p))
  , \p -> left p
  } (a,b)

lcm = \a b -> dDiv (dTimes a b) (gcd a b)

[Rational, fromRational, toRational, rPlus, rTimes, rMinus, rDiv] = \h ->
  let rNum = \x -> left (right x)
      rDen = \x -> right (right x)
  in [ \n d -> if dEqual d 0
               then abort "Denominator cannot be zero"
               else let g = gcd n d
                    in (h, (dDiv n g, dDiv d g))
     , Rational
     , \a b -> fromRational (dPlus (dTimes (rNum a) (rDen b)) (dTimes (rNum b) (rDen a)))
                            (dTimes (rDen a) (rDen b))
     , \a b -> fromRational (dTimes (rNum a) (rNum b))
                            (dTimes (rDen a) (rDen b))
     , \a b -> fromRational (dMinus (dTimes (rNum a) (rDen b)) (dTimes (rNum b) (rDen a)))
                            (dTimes (rDen a) (rDen b))
     , \a b -> fromRational (dTimes (rNum a) (rDen b))
                            (dTimes (rDen a) (rNum b))
     ]
import Prelude

-- LIMIT: a recursion whose test reads input that nothing bounds cannot be
--   sized, so the program does not compile. This is not a budget problem --
--   raising the sizing budget would not help, because no finite iteration
--   count can be proven at all.
-- EXPECTED: a compile error nami(ng this recursion and asking for a refinement.
-- OBSERVED: could not size recursion #0 at unbounded-input-recursion:27:34:
--   its test depends on input that nothing bounds, so no finite iteration
--   count can be proven for it. Constrain that input with a refinement
--   (`x : someValidator`) or an `assert` before recursing on it.
-- WORKAROUND: bound the input first, with a refinement on the `let` binding.
--   `valid` asserts the character is under 33, which tells the sizing pass the
--   recursion can peel at most 33 layers -- see the commented lines below.

countDown = { \i -> i
            , \recur i -> recur (left i)
            , \i -> 0
            }

-- WORKAROUND (compiles): refine the input before recursing on it.
-- valid = \x -> assert (not ($33 left x)) "input too large"

main = \input -> let userInput = left input
                     firstChar = left userInput
                     -- WORKAROUND: firstChar : valid = left userInput
                     output = if countDown firstChar then "!" else "#"
                 in if not (toBool input)
                    then (" ", 1)
                    else (output, 0)
import Prelude

-- LIMIT: sizing works by unrolling the recursion abstractly, one level at a
--   time, until its test stops. That search has a budget, and a recursion that
--   genuinely needs more levels than the budget allows is rejected -- even
--   though it is perfectly total.
-- EXPECTED: a compile error naming this recursion and the depth reached.
-- OBSERVED (at a budget of 5): could not size recursion #0 at
--   over-budget-recursion:30:34: its test had still not stopped after 6
--   unrollings. Either it needs a deeper recursion than the sizing budget
--   allows, or its test never stops.
-- NOTE: this program COMPILES at the CLI's budget of 65536. It is here to
--   exercise the budget-exhaustion path, which the test suite drives with a
--   deliberately tiny budget. The two failures are worth telling apart: this
--   one is fixed by a bigger budget or a shallower recursion, whereas
--   unbounded-input-recursion.tel cannot be fixed by any budget.
-- WORKAROUND: bound the recursion more tightly, so it needs fewer levels --
--   see the commented refinement below, which peels 3 layers instZead of 33.

valid = \x -> assert (not ($33 left x)) "input too large"
-- WORKAROUND (sizes within a small budget): -- valid = \x -> assert (not ($3 left x)) "input too large"

countDown = { \i -> i
            , \recur i -> recur (left i)
            , \i -> 0
            }

main = \input -> let userInput = left input
                     firstChar : valid = left userInput
                     output = if countDown firstChar then "!" else "#"
                 in if not (toBool input)
                    then (" ", 1)
                    else (output, 0)
import Prelude

drawPiece = \piece alt -> if piece
                             then if left piece
                                     then "O"
                                     else "X"
                             else alt

-- drawBoard
drawBoard
 = \pieces -> let getPiece = \n -> left (n (\x -> right x) pieces)
                  alt = \n -> (n succ (left "1"), 0)
                  dp = \n -> drawPiece (getPiece n) (alt n)
                  blankRow = "-+-+-\n"
              in concat [ dp $0, "|", dp $1, "|", dp $2, "\n"
                        , blankRow
                        , dp $3, "|", dp $4, "|", dp $5, "\n"
                        , blankRow
                        , dp $6, "|", dp $7, "|", dp $8, "\n"
                        ]

setPiece
 = \player pos board -> let before = take pos board
                            after = right (drop pos board)
                        in concat [before, (player,0), after]

getSquare
 = \pos board -> left (drop pos board)

fullBoard
 = \board -> let squares = map (\x -> getSquare (d2c x) board) [0,1,2,3,4,5,6,7,8]
             in foldr and 1 (map toBool squares)

emptyBoard = [0,0,0,0,0,0,0,0,0]

-- validInput = \x -> assert (and x (and (not (right x)) (not ($127 left x)))) "invalid input"
-- validInput = \x -> assert (not ($127 left x)) "invalid input"
validInput = \x -> assert (and (not (toBool ($127 left x))) (not (toBool (right x)))) "invalid input"
validPlayer = \x -> assert (not (toBool ($3 left x))) "invalid player state"
validBoard = \x -> assert (not (toBool ($9 right x))) "invalid board state"

processInput
 = \string -> let num = dMinus (left string) (left "0")
              in if and (toBool num) (toBool (dMinus 10 num))
                 then num
                 else 0

whoWon
 = \board -> let rows = [[0,1,2]
                        ,[3,4,5]
                        ,[6,7,8]
                        ,[0,3,6]
                        ,[1,4,7]
                        ,[2,5,8]
                        ,[0,4,8]
                        ,[2,4,6]
                        ]
                 doRow
                   = \row -> let pieces = map (\x -> getSquare (d2c x) board) row
                                 oneWins = foldr and 1 (map (dEqual 1) pieces)
                                 twoWins = foldr and 1 (map (dEqual 2) pieces)
                             in if oneWins then 1 else if twoWins then 2 else 0
                 combineRow
                   = \row winAcc -> if winAcc then winAcc else doRow row
             in foldr combineRow 0 rows

main
 = \input -> let placeString : validInput = left input
                 oldState = right input
                 boardIn : validBoard = right oldState
                 playerIn : validPlayer = left oldState
                 oldBoard = if boardIn then boardIn else emptyBoard
                 place = processInput placeString
                 placeOccupied = getSquare (d2c (left place)) oldBoard
                 validPlace = and (toBool place) (not (toBool placeOccupied))
                 newBoard = if validPlace
                               then setPiece (succ playerIn) (d2c (left place)) oldBoard
                               else oldBoard
                 winner = whoWon newBoard
                 filledBoard = fullBoard newBoard
                 showBoard = or (and validPlace
                                     (and (not (toBool winner))
                                          (not filledBoard)
                                     )
                                )
                          (not (toBool boardIn))
                 doEnd = if winner then concat [ "Player "
                                               , (d2c winner succ (left "0"), 0)
                                               , " wins!"
                                               ]
                                   else "the game is a tie"
                 nextPlayer = if showBoard then not playerIn else playerIn
                 output = if showBoard
                             then concat [ (drawBoard newBoard)
                                         , "Player "
                                         , (d2c nextPlayer succ (left "1"), 0)
                                         , "'s turn\n"
                                         , "please input number of square: "
                                         ]
                             else if dEqual placeString "q"
                                     then 0
                                     else if not (toBool place)
                                             then "please enter a number 1-9"
                                             else if not validPlace
                                                     then "please choose unoccupied space"
                                                     else doEnd
                 nextState = if and (toBool output)
                                    (and (not filledBoard)
                                         (not (toBool winner))
                                    )
                                then (nextPlayer,newBoard)
                                else 0
             in (output, nextState)



