+
+// A term's key up to the names of its binders (variables are told apart
+// by their indices), without spans or annotations.
+function term_key_alpha(t: HTerm): string {
+  const walk = (v: any): any => {
+    if (Array.isArray(v)) {
+      return v.map(walk);
+    }
+    if (v === null || typeof v !== "object") {
+      return v;
+    }
+    if (v.$ === "Ann") {
+      return walk(Bend.term_strip(v));
+    }
+    const named = v.$ === "Lam" || v.$ === "Var" || v.$ === "Let";
+    return Object.fromEntries(Object.keys(v)
+      .filter((k) => k !== "s" && !(named && k === "k")).map((k) => [k, walk(v[k])]));
+  };
+  return JSON.stringify(walk(Bend.term_lower(t)));
+}
+
+// A U32 match compiles to a tree over the word's bits: rows of whole
+// literals, and a default row wherever the tree leaves the literals'
+// paths, each with its own copy of the default. When every default row
+// is the same term whatever its bits, the literals are tested whole and
+// one row catches everything else: code for the default once, and a
+// test per literal instead of one per bit.
+function lits_merge(rows: Row[]): Row[] {
+  const out = rows.filter(([, j]) => j < 32);
+  if (out.length < 2) {
+    return rows;
+  }
+  const body = ([h, , , e]: Row, k: number): string => term_key_alpha([...Array(e)]
+    .reduce((f: HTerm, _, i) => Bend.term_apply(f, probe("_m" + k + "_" + i)), h));
+  const b0 = body(out[0], 0);
+  if (!out.every((r, k) => body(r, k) === b0)) {
+    return rows;
+  }
+  const [h, j, , e] = out[0];
+  return [...rows.filter(([, j]) => j === 32), [h, j, -1, e]];
+}
